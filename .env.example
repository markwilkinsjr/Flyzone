# ---- Tastytrade SANDBOX (orders are routed here) ----
# From the sandbox OAuth application you created at developer.tastytrade.com
TASTYTRADE_SANDBOX_CLIENT_SECRET=
TASTYTRADE_SANDBOX_REFRESH_TOKEN=
TASTYTRADE_SANDBOX_ACCOUNT_NUMBER=
# Must stay "true" while testing. The bot refuses to route orders to a
# non-sandbox session unless this is explicitly set to "false".
TASTYTRADE_IS_SANDBOX=true

# ---- Tastytrade PRODUCTION (read-only market data: chains, Greeks, OI, candles) ----
# The sandbox has no usable market data, so levels come from production.
# The bot never places orders through this session.
TASTYTRADE_PROD_CLIENT_SECRET=
TASTYTRADE_PROD_REFRESH_TOKEN=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Only this chat may issue /status, /pause, /resume, /flatten
TELEGRAM_CHAT_ID=

# ---- Behaviour ----
# true  = compute levels, send every alert, simulate fills locally, never send an order
# false = send real orders to the sandbox (or production if TASTYTRADE_IS_SANDBOX=false)
DRY_RUN=true
LOG_LEVEL=INFO
STATE_FILE=state.json

# ---- Only for real-money trading later (leave blank in sandbox) ----
# TASTYTRADE_LIVE_ACCOUNT_NUMBER=
# I_UNDERSTAND_THIS_IS_LIVE_TRADING=yes
